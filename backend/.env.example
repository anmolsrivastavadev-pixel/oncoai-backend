# Copy to .env and adjust. Never commit the real .env.
ENVIRONMENT=development            # development | test | production
DATABASE_URL=postgresql+psycopg://oncoai:oncoai@localhost:5432/oncoai
# REQUIRED in production: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
CORS_ORIGINS=http://localhost:5173,capacitor://localhost,http://localhost,https://localhost

# Image storage. Set IMAGE_ENCRYPTION_KEY to encrypt photos at rest:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
UPLOAD_DIR=./uploads
IMAGE_ENCRYPTION_KEY=

# Scan model (see README "Scan model"). auto = ViT if a checkpoint is present, else heuristic.
ANALYZER_KIND=auto
MODEL_DIR=./models/skin-lesion-vit
MODEL_REPO_ID=Anwarkh1/Skin_Cancer-Image_Classification

# Assistant. Leave empty to use the built-in educational knowledge base only.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5

RATE_LIMIT_ENABLED=true
SEED_SAMPLE_DATA=true
LOG_LEVEL=INFO
